{
  "name": "regime-alpha",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run update:data && next build",
    "build:static": "next build",
    "deploy:cloudflare": "npm run build && wrangler pages deploy out --project-name regimealpha --branch main",
    "deploy:worker": "wrangler deploy --config wrangler.regime-updater.jsonc",
    "d1:migrate:local": "wrangler d1 migrations apply regimealpha-production --local --config wrangler.regime-updater.jsonc",
    "d1:migrate:remote": "wrangler d1 migrations apply regimealpha-production --remote --config wrangler.regime-updater.jsonc",
    "d1:seed:sql": "node scripts/create-d1-seed-sql.mjs",
    "deploy:mcp": "wrangler deploy --config wrangler.regime-mcp.jsonc",
    "start": "next start",
    "test": "node --test",
    "update:data": "node scripts/build-regimes-cli.mjs",
    "update:data:incremental": "REGIME_INCREMENTAL=1 node scripts/build-regimes-cli.mjs",
    "update:data:refresh": "REGIME_REFRESH=1 node scripts/build-regimes-cli.mjs",
    "verify:strategy-knowledge": "node scripts/verify-strategy-knowledge.mjs",
    "verify:mcp-strategy": "node scripts/verify-mcp-strategy.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.13.2",
    "next": "^16.3.1",
    "react": "latest",
    "react-dom": "latest",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "wrangler": "^4.90.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
